# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beta_mod_hub

# Build-file storage.
# Production on Oracle uses local with /app/data backed by a persistent named
# Docker volume. r2 remains available for a future S3-compatible migration.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# One-time R2 provisioning only (scripts/setup-r2.mjs): a bootstrap API token
# with Account > Workers R2 Storage > Edit and User > API Tokens > Edit.
# Revoke it after setup — the app itself only needs the STORAGE_* values above.
# CLOUDFLARE_API_TOKEN=

# Nexus integration
# Personal API key for local dev/testing only — see the API Acceptable Use
# Policy note in the spec before this app has real users. SSO client
# credentials go here once the app is registered with Nexus.
NEXUS_PERSONAL_API_KEY=
NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=

# Encrypted at-rest storage for each user's Nexus credential (nexus_links).
# Base64 of exactly 32 random bytes. Required before NexusLink features run.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Nexus SSO (OAuth2 authorization-code) — scaffold placeholders. The endpoint
# URLs and userinfo field names get confirmed against Nexus's SSO docs once
# the app is registered. Unset = SSO disabled; email+password remains.
NEXUS_SSO_REDIRECT_URI=http://localhost:3000/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=
# Optional tuning for the read-API client (lib/nexus.ts).
# NEXUS_API_BASE=https://api.nexusmods.com/v1
# NEXUS_RATE_LIMIT_MS=500

# Auth / sessions
SESSION_SECRET=

# Malware scanning — required before accepting any uploaded file.
# SCAN_ENDPOINT is the ClamAV-backed scan service the deployed app calls.
# Local dev: run `node scripts/scan-server.mjs` against a local clamd and set
# SCAN_ENDPOINT=http://127.0.0.1:3311 — uploads refuse to run without a scanner.
MALWARE_SCAN_API_KEY=
SCAN_ENDPOINT=
