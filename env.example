# Local development. Copy to .env.local and use your own disposable database.
# For hosted deployments, start with the matching .env.*.example instead.
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/beta_mod_hub

# Local storage writes under data/. R2 and S3-compatible storage are optional.
# The hosted cloud pilot uses the separate .env.cloud.example configuration.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# One-time R2 provisioning only (scripts/setup-r2.mjs): a bootstrap API token
# with Account > Workers R2 Storage > Edit and User > API Tokens > Edit.
# Revoke it after setup. The app only needs the STORAGE_* values above.
# CLOUDFLARE_API_TOKEN=

# Nexus integration
# Optional, unfinished integration. Leave these blank for ordinary development.
# Use only approved credentials and check Nexus's policy before integration work.
NEXUS_PERSONAL_API_KEY=
NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=

# Encrypted at-rest storage for each user's Nexus credential (nexus_links).
# Base64 of exactly 32 random bytes. Required before NexusLink features run.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Nexus SSO is not validated against the live provider. Endpoint URLs and
# userinfo fields still need verification. Unset means SSO stays disabled.
NEXUS_SSO_REDIRECT_URI=http://localhost:3000/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=
# Optional tuning for the read-API client (lib/nexus.ts).
# NEXUS_API_BASE=https://api.nexusmods.com/v1
# NEXUS_RATE_LIMIT_MS=500

# Auth / sessions
SESSION_SECRET=
APP_URL=http://127.0.0.1:3000
# Explicit trusted account UUIDs, comma-separated. Email strings grant no access.
ADMIN_USER_IDS=
# Account email: smtp or resend for hosted use; preview for loopback development.
# See ACCOUNT-SETUP.md. Preview writes private email files outside the repository.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
AUTH_MAIL_FROM=
# Local-only, explicitly opt in if needed. Never enable on public hosting.
AUTH_MAIL_MODE=
AUTH_ALLOW_UNVERIFIED_LOCAL=false

# Malware scanning is required before accepting any uploaded file.
# SCAN_ENDPOINT is the local ClamAV-backed scan service.
# Local dev: run `node --env-file=.env.local scripts/scan-server.mjs` against
# a local clamd. Keep the wrapper on loopback and set both keys below to the
# same new local secret. See CONTRIBUTING.md for the complete scanner setup.
SCAN_SERVER_HOST=127.0.0.1
SCAN_SERVER_PORT=3311
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
SCAN_API_KEY=
SCAN_DRIVER=clamav
MALWARE_SCAN_API_KEY=
SCAN_ENDPOINT=http://127.0.0.1:3311
