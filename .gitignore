# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-check/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production
.env.home
.env.*.local
!.env.example

# backup output, if a backup dir is ever pointed inside the repo
# (the documented default lives outside it — see DEPLOY-HOME.md)
/backups/

# account recovery codes — secrets, must never be committed
/github-recovery-codes.txt

# local dev uploads (when STORAGE_DRIVER=local is used)
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
