# Bounded cloud-only pilot template; no live credentials. See DEPLOY-CLOUD.md.
# Use the cloud host's secret environment settings. For a private local copy,
# use .env.cloud.local (gitignored), NOT .env.cloud. Never commit real values.
# The launcher does not load this template or .env.cloud.local automatically.

# Render native Node runtime setting; build and start with CLOUD_PILOT=on.
NODE_VERSION=22
NODE_ENV=production
CLOUD_PILOT=on
PILOT_MODE=on
STORAGE_DRIVER=s3
SCAN_DRIVER=transloadit
AUTH_MAIL_MODE=resend

# Isolated Neon pilot branch only, pooled hostname and sslmode=require.
# Never use the existing production branch or repoint .env.local/.env.home.
DATABASE_URL=
# Exact HTTPS origin of the assigned Render service; no path or trailing data.
APP_URL=
# Independent, stable random secrets, at least 32 characters each.
SESSION_SECRET=
PILOT_ACCESS_KEY=
# Base64 encoding of exactly 32 random bytes. Keep stable and backed up safely.
ENCRYPTION_KEY=
# Actual verified account UUIDs, comma-separated. Email addresses are NOT admins.
ADMIN_USER_IDS=

# Dedicated Supabase Free project; private bucket with no anonymous read/write.
# Copy endpoint and region from that project's S3 settings, not a public URL.
STORAGE_ENDPOINT=https://project-ref.storage.supabase.co/storage/v1/s3
STORAGE_REGION=
STORAGE_BUCKET=betamods-pilot
# Server-only S3 credentials bypass RLS and cover all project buckets.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Existing Transloadit Community account: no payment card, no paid upgrade.
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Match the selected dashboard key exactly. Evaluated named key uses sha256.
# New keys may use sha384. The adapter never guesses or retries another method.
TRANSLOADIT_SIGNATURE_ALGORITHM=sha256
# App accounting ceiling, MiB estimates per UTC calendar month, NOT provider GB.
# Can be lowered but cannot be raised beyond 3072 in cloud pilot code.
TRANSLOADIT_MONTHLY_BUDGET_MIB=3072

# Resend Free, HTTPS API. Verify the sender domain before inviting testers.
# Leave paid subscriptions and transactional overages disabled.
RESEND_API_KEY=
AUTH_MAIL_FROM=

# App safety ceilings. Increasing these values cannot raise cloud pilot caps.
# 8 MiB/file, 128 MiB/account ceiling, 100 MiB total; five approved uploaders.
PILOT_MAX_ARCHIVE_BYTES=8388608
PILOT_MAX_BYTES_PER_TESTER=134217728
PILOT_MAX_TOTAL_BYTES=104857600
PILOT_MAX_UPLOADERS=5
PILOT_UPLOADS_PER_WINDOW=5
PILOT_UPLOAD_WINDOW_MINUTES=60
DOWNLOAD_URL_TTL_SECONDS=300

# Do NOT copy AUTH_ALLOW_UNVERIFIED_LOCAL, AUTH_MAIL_MODE=preview, SCAN_ENDPOINT,
# local ClamAV settings, R2 bootstrap tokens, or any tunnel token here.
# Render supplies PORT; the cloud launcher defaults to 10000 if it is absent.
# Leave Nexus SSO unconfigured until its actual registration details are verified.
