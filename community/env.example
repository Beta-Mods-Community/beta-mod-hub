# Optional local development configuration. Copy to .env.local only if needed.
# UI-only development and credential-free checks do not need this file.
# Supply a URL for YOUR dedicated development database, never the live service.
DATABASE_URL=
APP_URL=http://127.0.0.1:3000
SESSION_SECRET=
ADMIN_USER_IDS=

# Local files stay in the gitignored data directory. No provider account needed.
STORAGE_DRIVER=local
CLOUD_PILOT=off
PILOT_MODE=off

# Local mail previews stay outside the repository. Bind dev to 127.0.0.1.
AUTH_MAIL_MODE=preview
AUTH_ALLOW_UNVERIFIED_LOCAL=false

# Real ClamAV scanning is mandatory for uploads, including development.
SCAN_DRIVER=clamav
SCAN_ENDPOINT=http://127.0.0.1:3311
MALWARE_SCAN_API_KEY=
# For the separately launched scan wrapper, use the same value as above.
SCAN_API_KEY=
SCAN_SERVER_HOST=127.0.0.1
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Optional Nexus integration remains disabled without confirmed registration.
ENCRYPTION_KEY=
NEXUS_PERSONAL_API_KEY=
NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=
NEXUS_SSO_REDIRECT_URI=http://127.0.0.1:3000/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=
