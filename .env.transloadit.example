# Evaluation credentials only. Copy to .env.transloadit.local (gitignored).
# Keep real credentials private and out of version control.
# Review the account's scan allowance and billing settings before live probes.
# The isolated probe does not read app, database, storage or production env files.
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Match the algorithm shown with the existing key; new keys default to sha384.
TRANSLOADIT_SIGNATURE_ALGORITHM=sha384
