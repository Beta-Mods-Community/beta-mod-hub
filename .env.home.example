# Copy to .env.home on the home-hosting PC. Never commit the real file.
#
# This is the production env for the home stack (compose.home.yml) — betamods.com
# served from a Windows PC behind a Cloudflare Tunnel. See DEPLOY-HOME.md.
# It is deliberately a SEPARATE file from .env.production, which belongs to the
# preserved Oracle fallback and says different things about SCAN_ENDPOINT.
#
# This file is always passed as `--env-file .env.home`, so it feeds BOTH the
# containers (via env_file) and the ${...} interpolation in the compose file.
# That is the point: SCAN_API_KEY below is read once and pushed to the app and
# the scan wrapper from the same variable, so the two can never disagree.
#
# compose.home.yml hard-sets STORAGE_DRIVER, SCAN_ENDPOINT and
# MALWARE_SCAN_API_KEY (they must not be editable here). They are listed in
# this file only so a reader can see the effective values.

# --- required ---------------------------------------------------------------

# Neon `main` branch, POOLED connection string (this goes through pgbouncer,
# which is what the app expects). Keep the matching DIRECT (non-pooled) string
# for backups, but do NOT put that here — see DEPLOY-HOME.md "Backups".
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/betamods?sslmode=require

# Long random value. The app refuses to sign sessions with anything else in
# production. It must stay IDENTICAL across restarts or every user is silently
# signed out and all in-flight uploads lose their session.
SESSION_SECRET=replace-with-a-long-random-value

# Shared secret between the app and the scan wrapper. compose.home.yml REQUIRES
# it (`:?`) and refuses to start without it. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCAN_API_KEY=replace-with-a-long-random-value

# --- Cloudflare R2 (where the mod archives actually live) --------------------

# Final storage for every uploaded build. NOT on this PC: the Docker volume is
# quarantine scratch that is emptied as each upload finishes, so nobody's only
# copy of a mod is sitting on a laptop disk.
#
# Create the bucket and a credential with scripts/setup-r2.mjs, which uses the
# account-wide bootstrap token from .env.local. Do that FIRST, then copy the
# four values below into this file.
#
# The credential MUST be bucket-scoped: read + write on this one bucket and
# nothing else. The bootstrap token can create buckets and mint other tokens
# account-wide — it is a setup tool, never a runtime credential. Leaving it
# out of this file is the point.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=betamods-storage
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- pilot limits ------------------------------------------------------------
#
# What the closed beta is allowed to consume. compose.home.yml passes these
# through with the values below as fallbacks, so an unset value still means
# "capped", never "unlimited".
#
# These caps are the ONLY thing keeping R2 storage inside the 10 GB-month free
# allowance. Cloudflare budget alerts are notifications that arrive after the
# fact; they do not stop a runaway upload. See DEPLOY-HOME.md "Cost safety".

# on = only accounts approved in the /admin console can upload.
# off = every mod owner can upload. (The app defaults to off so dev and the
# e2e test are unrestricted; the home target sets on.)
PILOT_MODE=on

# Max single archive, in bytes. 250 MiB.
PILOT_MAX_ARCHIVE_BYTES=262144000
# Max total stored per tester, in bytes. 1.5 GiB.
PILOT_MAX_BYTES_PER_TESTER=1610612736
# Max total stored across the whole pilot, in bytes. 8 GiB.
# This is the one that matters for cost — do not raise it without re-reading
# DEPLOY-HOME.md, because past 10 GB-month R2 starts billing.
PILOT_MAX_TOTAL_BYTES=8589934592

# How many accounts may hold an upload approval at once.
PILOT_MAX_UPLOADERS=5
# Upload attempts allowed per window per tester. A failed upload still counts
# as an attempt, so this also slows down a client spamming the endpoint.
PILOT_UPLOADS_PER_WINDOW=10
PILOT_UPLOAD_WINDOW_MINUTES=60
# How long a presigned download URL stays valid. Short on purpose: the URL is
# the download, and a shared link should stop working quickly.
DOWNLOAD_URL_TTL_SECONDS=300

# --- admin -------------------------------------------------------------------

# Who can reach /admin (the upload kill switch, the allowlist, and usage
# numbers). Comma-separated. An empty value means nobody is an admin and the
# page refuses everyone — it does not default to open.
#
# Must be the exact email the account signed up with.
ADMIN_EMAILS=owner@betamods.com

# --- required before Nexus credential storage runs ---------------------------

# Base64 of exactly 32 random bytes. AES-256-GCM key for each user's encrypted
# Nexus credentials (nexus_links). Generate once and keep it stable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Cloudflare Tunnel -------------------------------------------------------

# Read only when the `tunnel` profile is enabled, so it can stay blank until
# the tunnel actually exists. Get it from Zero Trust -> Networks -> Tunnels
# -> your tunnel -> Configure -> Install connector (the Docker command; copy
# just the token). Do not create it until the local stack is verified.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Nexus integration -------------------------------------------------------
# Set after app registration with Nexus. Unset = SSO disabled and email+password
# remains the login path.

NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=
NEXUS_SSO_REDIRECT_URI=https://betamods.com/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=

# --- set by compose.home.yml, shown for reference only ----------------------
# Do not edit these to change behaviour; edit the compose file so the value
# cannot be weakened by editing an env file.
#
#   STORAGE_DRIVER=r2
#   STORAGE_ENDPOINT / STORAGE_BUCKET / STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY
#                      (the R2 values above, required — the stack refuses to
#                       start without them, so local storage is unreachable)
#   SCAN_ENDPOINT=http://scan-server:3311
#   MALWARE_SCAN_API_KEY=<same value as SCAN_API_KEY above>
#   PILOT_* / DOWNLOAD_URL_TTL_SECONDS (the pilot values above)
