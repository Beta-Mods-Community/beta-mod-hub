# Copy to .env.production on the Oracle host. Never commit the real file.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value

# Required once NexusLink features run (Nexus credential encryption at rest).
# Base64 of exactly 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Nexus integration — set after app registration with Nexus. All three SSO
# URLs are placeholders until then; unset = SSO disabled.
NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=
NEXUS_SSO_REDIRECT_URI=https://betamods.com/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=

# These are intentionally local: compose.oracle.yml persists /app/data in a
# named volume, avoiding usage-billed object-storage overages.
STORAGE_DRIVER=local

# The app talks to its local scan wrapper; the wrapper talks to the ClamAV
# container over the private Compose network.
SCAN_ENDPOINT=http://127.0.0.1:3311
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Optional shared secret between the app and scan wrapper.
SCAN_API_KEY=
MALWARE_SCAN_API_KEY=
