# Copy to .env.production on the Oracle host. Never commit the real file.
#
# Optional Oracle Compose target only. The hosted site uses the cloud profile;
# see .env.cloud.example and DEPLOY-CLOUD.md. Do not share environment files
# between targets or point contributor setups at the live database.
#
# Use Neon's pooled connection string for the app.
# Keep a separate DIRECT (non-pooled) connection string for backups
# (pg_dump). See DEPLOY.md for backup requirements.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_USER_IDS=
APP_URL=https://example.com
# Verification/password-reset email; see ACCOUNT-SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Required before any Nexus credential storage runs (AES-256-GCM key for the
# encrypted per-user Nexus credentials in nexus_links). The app will not run
# those features without it. Generate once, keep it stable across restarts:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Nexus integration is unfinished. Keep disabled until provider configuration
# and the end-to-end flow have been verified.
NEXUS_SSO_CLIENT_ID=
NEXUS_SSO_CLIENT_SECRET=
NEXUS_SSO_REDIRECT_URI=https://example.com/nexus-sso/callback
NEXUS_SSO_AUTHORIZE_URL=
NEXUS_SSO_TOKEN_URL=
NEXUS_SSO_USERINFO_URL=
NEXUS_SSO_SCOPES=

# These are intentionally local: compose.oracle.yml persists /app/data in a
# named volume, avoiding usage-billed object-storage overages.
STORAGE_DRIVER=local

# The app talks to its local scan wrapper; the wrapper talks to the ClamAV
# container over the private Compose network.
SCAN_ENDPOINT=http://127.0.0.1:3311
CLAMD_HOST=clamav
CLAMD_PORT=3310

# Optional shared secret between the app and scan wrapper. If you set one,
# set BOTH to the same value. A mismatch turns every scan into a 401 and
# breaks uploads. Leave both blank to disable auth (the wrapper only listens
# inside the app container).
SCAN_API_KEY=
MALWARE_SCAN_API_KEY=
