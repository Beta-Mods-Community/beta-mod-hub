{
  "name": "beta-mod-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "e2e": "node scripts/e2e-upload.mjs",
    "e2e:profile": "node scripts/e2e-profile.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "home": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1",
    "home:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1 up",
    "home:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1 status",
    "home:logs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1 logs",
    "home:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1 verify",
    "home:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-stack.ps1 backup"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
